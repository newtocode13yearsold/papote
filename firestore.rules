rules_version = '2';

// Règles de sécurité du chat.
// Idée : on ne peut lire que SES conversations, et on ne peut écrire
// des messages que dans une conversation acceptée par les deux amis.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function validName(n) { return n is string && n.matches('^[A-Za-z0-9_.]{3,20}$'); }
    function validPrefs(p) {
      return p is map
        && p.keys().hasAll(['theme', 'accent', 'wallpaper', 'textSize'])
        && p.keys().hasOnly(['theme', 'accent', 'wallpaper', 'textSize'])
        && p.theme in ['auto', 'light', 'dark']
        && p.accent is string && p.accent.matches('^#[0-9a-f]{6}$')
        && p.wallpaper in ['none', 'dots', 'grid', 'gradient', 'stars']
        && p.textSize in ['s', 'm', 'l'];
    }

    // Pseudo -> uid (sert à garantir qu'un pseudo n'est pris qu'une fois)
    match /usernames/{name} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == me()
        && name.matches('^[a-z0-9_.]{3,20}$')
        && !exists(/databases/$(database)/documents/users/$(me()))
        && getAfter(/databases/$(database)/documents/users/$(me())).data.usernameLower == name;
      allow update, delete: if false;
    }

    // Profil public : seulement le pseudo (l'email n'est JAMAIS stocké ici)
    // Tout le monde (connecté) peut voir la liste des membres pour les ajouter en amis.
    match /users/{uid} {
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit <= 500;
      allow create: if signedIn() && uid == me()
        && request.resource.data.keys().hasOnly(['username', 'usernameLower', 'createdAt'])
        && validName(request.resource.data.username)
        && request.resource.data.usernameLower == request.resource.data.username.lower()
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.usernameLower)).data.uid == me();

      // On peut seulement changer SES couleurs (mode nuit, couleur, fond, taille du texte)
      allow update: if signedIn() && uid == me()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['prefs'])
        && validPrefs(request.resource.data.prefs);
      allow delete: if false;
    }

    // Une conversation = une amitié entre 2 personnes (id = les deux uid triés, séparés par "_")
    // ou un groupe (id = "g_" + un id au hasard, group = true, 3 à 20 membres).
    match /chats/{chatId} {
      function isMember(data) { return me() in data.members; }
      function isGroup(data) { return data.get('group', false) == true; }
      function other(data) { return data.members[0] == me() ? data.members[1] : data.members[0]; }
      function nameOf(uid) { return get(/databases/$(database)/documents/users/$(uid)).data.username; }
      function validTitle(t) { return t is string && t.size() >= 1 && t.size() <= 40; }
      // Une liste de membres sans doublon, 20 personnes maximum
      function validMembers(m) { return m is list && m.size() <= 20 && m.toSet().size() == m.size(); }

      allow read: if signedIn() && isMember(resource.data);

      // Créer un groupe (avec au moins 2 amis)
      allow create: if signedIn()
        && chatId.matches('^g_[A-Za-z0-9]{10,40}$')
        && request.resource.data.keys().hasOnly(['group', 'title', 'members', 'createdBy', 'accepted', 'createdAt', 'lastAt', 'lastText', 'lastFrom'])
        && request.resource.data.group == true
        && validTitle(request.resource.data.title)
        && validMembers(request.resource.data.members)
        && request.resource.data.members.size() >= 3
        && isMember(request.resource.data)
        && request.resource.data.createdBy == me()
        && request.resource.data.accepted == true
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastAt == request.time
        && request.resource.data.lastText == ''
        && request.resource.data.lastFrom == '';

      // Demande d'ami
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['members', 'names', 'requestedBy', 'accepted', 'createdAt', 'lastAt', 'lastText', 'lastFrom'])
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.resource.data.members[0] < request.resource.data.members[1]
        && chatId == request.resource.data.members[0] + '_' + request.resource.data.members[1]
        && isMember(request.resource.data)
        && request.resource.data.requestedBy == me()
        && request.resource.data.accepted == false
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastAt == request.time
        && request.resource.data.lastText == ''
        && request.resource.data.lastFrom == ''
        && request.resource.data.names.keys().hasOnly(request.resource.data.members)
        && request.resource.data.names[me()] == nameOf(me())
        && request.resource.data.names[other(request.resource.data)] == nameOf(other(request.resource.data));

      // Accepter la demande (seulement celui qui l'a reçue)
      // ou mettre à jour le "dernier message" (seulement un membre, conversation acceptée)
      // ou dire "j'ai vu les messages" (chacun ne peut changer que SON heure de lecture)
      allow update: if signedIn() && isMember(resource.data)
        && (
          (resource.data.accepted == false
            && resource.data.requestedBy != me()
            && request.resource.data.accepted == true
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accepted']))
          ||
          (resource.data.accepted == true
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastAt', 'lastText', 'lastFrom'])
            && request.resource.data.lastFrom == me()
            && request.resource.data.lastAt == request.time
            && request.resource.data.lastText is string
            && request.resource.data.lastText.size() <= 1000)
          ||
          (resource.data.accepted == true
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reads'])
            && request.resource.data.reads is map
            && request.resource.data.reads.diff(resource.data.get('reads', {})).affectedKeys().hasOnly([me()])
            && request.resource.data.reads[me()] == request.time)
          ||
          // Groupe : renommer
          (isGroup(resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title'])
            && validTitle(request.resource.data.title))
          ||
          // Groupe : ajouter des membres (on ne peut retirer personne d'autre)
          (isGroup(resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
            && validMembers(request.resource.data.members)
            && request.resource.data.members.toSet().hasAll(resource.data.members))
          ||
          // Groupe : quitter (on ne peut retirer que soi-même)
          (isGroup(resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
            && request.resource.data.members is list
            && request.resource.data.members.size() == resource.data.members.size() - 1
            && !(me() in request.resource.data.members)
            && resource.data.members.toSet().hasAll(request.resource.data.members))
        );

      // Refuser une demande / retirer un ami.
      // Un groupe : seulement celui qui l'a créé, ou le dernier membre qui reste.
      allow delete: if signedIn() && isMember(resource.data)
        && (!isGroup(resource.data)
            || resource.data.createdBy == me()
            || resource.data.members.size() == 1);

      match /messages/{msgId} {
        function chat() { return get(/databases/$(database)/documents/chats/$(chatId)).data; }

        // Photo, vidéo ou fichier : rangé dans Storage sous chats/{chatId}/{msgId}/...
        function validFile(f) {
          return f is map
            && f.keys().hasAll(['url', 'path', 'name', 'type', 'size'])
            && f.keys().hasOnly(['url', 'path', 'name', 'type', 'size'])
            && f.url is string && f.url.matches('^https://firebasestorage[.]googleapis[.]com/.*')
            && f.path is string && f.path.matches('^chats/' + chatId + '/' + msgId + '/[^/]+$')
            && f.name is string && f.name.size() > 0 && f.name.size() <= 200
            && f.type is string && f.type.size() <= 200
            && f.size is int && f.size >= 0;
        }

        // Photo rangée directement dans le message (réduite par le site avant l'envoi),
        // comme ça pas besoin de Firebase Storage.
        function validImage(i) {
          return i is map
            && i.keys().hasAll(['data', 'w', 'h'])
            && i.keys().hasOnly(['data', 'w', 'h', 'name'])
            && i.data is string && i.data.size() <= 900000
            && i.data.matches('^data:image/(jpeg|png|webp|gif);base64,[A-Za-z0-9+/=]+$')
            && i.w is int && i.w > 0 && i.w <= 5000
            && i.h is int && i.h > 0 && i.h <= 5000
            && (!('name' in i) || (i.name is string && i.name.size() <= 200));
        }

        // Réponse à un message : un petit extrait du message d'origine (qui doit exister)
        function validReply(r) {
          return r is map
            && r.keys().hasAll(['id', 'from', 'text'])
            && r.keys().hasOnly(['id', 'from', 'text'])
            && r.id is string && r.id.size() > 0 && r.id.size() <= 100 && r.id != msgId
            && r.from is string && r.from.size() <= 128
            && r.text is string && r.text.size() <= 200
            && exists(/databases/$(database)/documents/chats/$(chatId)/messages/$(r.id));
        }

        allow read: if signedIn() && me() in chat().members;
        allow create: if signedIn()
          && me() in chat().members
          && chat().accepted == true
          && request.resource.data.keys().hasOnly(['from', 'text', 'at', 'file', 'image', 'replyTo'])
          && (!('replyTo' in request.resource.data) || validReply(request.resource.data.replyTo))
          && (!('file' in request.resource.data) || validFile(request.resource.data.file))
          && (!('image' in request.resource.data) || validImage(request.resource.data.image))
          && request.resource.data.from == me()
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 1000
          && request.resource.data.at == request.time
          && ('file' in request.resource.data
                || 'image' in request.resource.data
                || request.resource.data.text.size() > 0);

        // Réagir avec un emoji : chacun ne peut changer (ou retirer) que SA réaction
        allow update: if signedIn()
          && me() in chat().members
          && chat().accepted == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
          && request.resource.data.reactions is map
          && request.resource.data.reactions.diff(resource.data.get('reactions', {})).affectedKeys().hasOnly([me()])
          && (!(me() in request.resource.data.reactions)
                || (request.resource.data.reactions[me()] is string
                    && request.resource.data.reactions[me()].size() > 0
                    && request.resource.data.reactions[me()].size() <= 16));
        allow delete: if false;
      }
    }
  }
}
